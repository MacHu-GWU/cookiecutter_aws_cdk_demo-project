// Copy to config/config-dev-secret.json5 (git-ignored; same for tst / prd) and fill in real values.
// Secrets of one environment, merged last, overriding every other file.
// Every key must be a field of Config (config_00_main.py).
{
  // The account this environment deploys to. Every cdk command stops
  // if the AWS profile of the environment (AWS_PROFILE_FOR_<ENV> in .env) points at another account.
  aws_account_id: "123456789012",
}
