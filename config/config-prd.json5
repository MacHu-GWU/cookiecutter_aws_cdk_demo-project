// Settings of the prd environment; overrides config-shared.json5.
{
  // The region this environment deploys to; aws_account_id is in the -secret file.
  // Every cdk command stops if the boto session (AWS_PROFILE) points anywhere else.
  aws_region: "us-east-1",
  // Value of the sample SSM parameter.
  hello_value: "hello world",
}
