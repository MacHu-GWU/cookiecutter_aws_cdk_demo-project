# Copy to .env (git-ignored); mise loads it for every task.
# The current environment (dev, tst, prd) of one.config / one.bsm when nothing else sets it;
# each cdk-<action>-<env>-* task sets its own. Defaults to dev.
ENV_NAME="dev"
# The local AWS CLI profile of each environment; one.bsm uses the one of the current environment.
# An environment without one falls back to AWS_PROFILE, then the default credential chain.
AWS_PROFILE_DEV="your_dev_aws_profile_name"
AWS_PROFILE_TST="your_tst_aws_profile_name"
AWS_PROFILE_PRD="your_prd_aws_profile_name"
