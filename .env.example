# Copy to .env (git-ignored); mise loads it for every task.
# The current environment (dev, tst, prd) of one.config / one.bsm when nothing else sets it;
# each cdk-<action>-<env>-* task sets its own. Defaults to dev.
ENV_NAME="dev"
# The AWS CLI profile of each environment, as named in your own ~/.aws/config (differs per
# person, so it lives here, not in mise.toml). The cdk-plan/up/down-<env>-* tasks pass it as
# --profile and stop if it is not set; one.bsm uses the one of the current environment.
AWS_PROFILE_FOR_DEV="your_dev_aws_profile_name"
AWS_PROFILE_FOR_TST="your_tst_aws_profile_name"
AWS_PROFILE_FOR_PRD="your_prd_aws_profile_name"
